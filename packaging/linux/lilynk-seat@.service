# lilynk seat: one user's headless desktop and stock host, started by lilynk-seats.
#
# The instance is the seat's Linux account (`lilynk-seat@pf-seat-1`). The supervisor writes
# /run/lilynk/seats/<user>.env and a drop-in with the BindPaths for this seat's private
# compatdata, shadercache and downloading, and the mounts of the owner's libraries, before each
# start; start the unit through `lilynk-seats start <id>`, not by hand.
[Unit]
Description=lilynk seat %i
After=systemd-logind.service systemd-user-sessions.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=%i
PAMName=login
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
EnvironmentFile=/run/lilynk/seats/%i.env
# Holds the session id for seat-reap.
RuntimeDirectory=lilynk-seat-%i
ExecStart=/usr/libexec/lilynk/seat-session
# A made seat's own loopback address for Steam's UI link, attached to its user's slice as root.
# `-`: a kernel that refuses the hook leaves a seat that starts all the same.
ExecStartPost=-+/usr/libexec/lilynk/lilynk-seats loopback %i
# pam_systemd moves the session's processes out of this unit, so stopping it reaches only the
# runner. The runner kills its children on SIGTERM; this kills the session for anything it missed.
# `-`: a failed reap must not skip the drop-in's later ExecStopPost= unmounts.
ExecStopPost=-+/usr/libexec/lilynk/seat-reap %i
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
