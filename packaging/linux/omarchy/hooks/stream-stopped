#!/usr/bin/env bash
#
# lilynk hook: a stream ended → a low-urgency Omarchy toast.
# Wired as a `stream.stopped` entry in ~/.config/lilynk/hooks.json by `lilynk-omarchy setup`.

set -euo pipefail

client="${PF_EVENT_STREAM_CLIENT:-a client}"
command -v omarchy-notification-send >/dev/null || exit 0
omarchy-notification-send --urgency=low --icon=org.projectcolony.lilynk "Lilynk" "$client disconnected"
