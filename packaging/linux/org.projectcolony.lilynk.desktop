[Desktop Entry]
Type=Application
Name=Lilynk
Name[de]=Lilynk
Name[es]=Lilynk
Name[fr]=Lilynk
Comment=Stream a remote Lilynk host
Comment[de]=Von einem entfernten Lilynk-Host streamen
Comment[es]=Transmite desde un host Lilynk remoto
Comment[fr]=Jouer en streaming depuis un hôte Lilynk distant
Comment[it]=Streaming da un host Lilynk remoto
Comment[pt_BR]=Transmita de um host remoto do Lilynk
Exec=lilynk-client %u
Icon=org.projectcolony.lilynk
Terminal=false
Categories=Network;Game;
Keywords=streaming;remote;game;moonlight;
Keywords[de]=Streaming;Fernzugriff;Spiel;Moonlight;
Keywords[es]=transmisión;streaming;remoto;juego;juegos;moonlight;
Keywords[fr]=streaming;diffusion;distant;jeu;jeux;moonlight;
Keywords[it]=streaming;remoto;gioco;giochi;moonlight;
Keywords[pt_BR]=streaming;transmissão;remoto;jogo;jogos;moonlight;
StartupNotify=true
MimeType=x-scheme-handler/lilynk;
