# Restart the running host, web console, plugin runner, seat supervisor and door once the
# transaction is done.
[Trigger]
Operation = Upgrade
Type = Package
Target = lilynk-host
Target = lilynk-seats
Target = lilynk-web
Target = lilynk-scripting
Target = lilynk-bun

[Action]
Description = Restarting the lilynk services...
When = PostTransaction
Exec = /usr/lib/lilynk/restart-user-units
