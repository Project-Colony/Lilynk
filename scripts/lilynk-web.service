# lilynk management web console — systemd USER unit (Nitro SSR on bun, port 47992, HTTPS,
# local network only unless host.env's LILYNK_UI_BIND says otherwise).
#
# Installed by the lilynk-web .deb to /usr/lib/systemd/user/. AUTO-WIRED — no env editing:
# it sources the host's mgmt token + the generated login password, serves HTTPS (HTTP/1.1 over TLS)
# with the host's own identity cert (~/.config/lilynk/native-{cert,key}.pem, falling back to the
# legacy {cert,key}.pem — see the LILYNK_UI_TLS_CERT note below), and points the /api proxy
# at the host's loopback HTTPS mgmt API. The self-signed cert is accepted only for that loopback hop,
# scoped inside the proxy code (Bun per-request TLS) — no process-wide NODE_TLS_REJECT_UNAUTHORIZED.
# Enable per user:
#   systemctl --user enable --now lilynk-web
[Unit]
Description=lilynk management web console
# web-init generates the login password AND blocks until the host has written the mgmt token +
# identity cert. It is the readiness gate; `After=lilynk-host.service` on its own is not one,
# because the host is Type=simple and systemd calls it started the moment it is spawned — seconds
# before either file lands. Keep web-init in BOTH lists: the ordering is what makes it a gate.
After=lilynk-web-init.service lilynk-host.service
# Stands down while the door is on: its own console (lilynk-web-door.service) serves this
# port. The seat supervisor writes the owner's contract before any user manager starts, so this
# holds at boot too, while the door's console still waits for the network.
ConditionPathExists=!/run/lilynk/seats/%u.env
ConditionPathExists=!/run/lilynk-web-door
# Wants, not Requires: if the pre-start unit itself fails, still try — the Restart backstop below
# recovers, where a hard dependency would leave the console down.
Wants=lilynk-web-init.service
# Backstop for whatever the gate above cannot cover (web-init timed out; the host re-minted its
# identity under a running console; someone deleted a file). Retry forever: a missing file must
# not leave the console down.
StartLimitIntervalSec=0

[Service]
Type=simple
# The host's configuration file, read for ONE key: LILYNK_UI_BIND — where the console listens
# (127.0.0.1, 0.0.0.0, or one address). First, so the console's own three files below still win
# any key they share. No `Environment=HOST=` line answers it: the server's own default is every
# interface, local peers only, so a missing file and a missing key mean the same thing. web-init.sh
# writes the key before this unit starts, so the operator finds it in the file.
EnvironmentFile=-%h/.config/lilynk/host.env
# Both are KEY=VALUE files. mgmt-token is REQUIRED (written by the host's `serve`) — a console with
# no token cannot reach the mgmt API at all, so failing closed beats serving a login page that 401s
# on every call. lilynk-web-init.service waits for it, so this no longer fails on a fresh
# install's first enable; if it is somehow still absent the unit fails + Restart retries.
# web-password is '-' optional (web-init creates it first, but a manual operator may inject
# LILYNK_UI_PASSWORD another way). It carries LILYNK_UI_PASSWORD_HASH once the console has
# hashed the generated password; the console rewrites the file itself, so nothing here changes.
EnvironmentFile=%h/.config/lilynk/mgmt-token
EnvironmentFile=-%h/.config/lilynk/web-password
# The host's ACTUAL mgmt port: `serve` writes this file (mgmt::publish_endpoint) with the port it
# really bound, so moving the listener — the fix for sharing a box with a Sunshine fork, which owns
# 47990 as its web UI — needs no edit here. Optional ('-'): an older host never wrote it, and the
# server's own built-in default (https://127.0.0.1:47990, util/mgmt.ts) then applies unchanged.
# No LILYNK_MGMT_URL default: an absent file leaves the server's own.
EnvironmentFile=-%h/.config/lilynk/mgmt-endpoint
Environment=PORT=47992
# Serve HTTPS (HTTP/1.1 over TLS) with the host's own identity cert; mark the
# session cookie Secure. The host's `serve` writes these PEMs LAST — after the mgmt token, inside
# mgmt::run — so they, not the token, are what web-init actually ends up waiting for. If absent at
# start the server exits and Restart retries rather than silently serving plain HTTP.
#
# These name the LEGACY pair and the server prefers the native sibling
# (native-cert.pem/native-key.pem) whenever it exists — `Environment=` cannot express "this file,
# else that one", so the choice is made in web/nitro-entry/tls-paths.mjs, which is the one place
# every launcher routes through. Don't "fix" these to the native names: a host that never took the
# identity split has no native pair, and the fallback lives on the other side of this handoff.
Environment=LILYNK_UI_TLS_CERT=%h/.config/lilynk/cert.pem
Environment=LILYNK_UI_TLS_KEY=%h/.config/lilynk/key.pem
Environment=LILYNK_UI_SECURE=1
ExecStart=/usr/bin/lilynk-web-server
# `always`, not `on-failure`: a console that exits 0 has still stopped serving, and on-failure would
# leave it down. An explicit `systemctl --user stop` is still honoured (Restart= never fights that).
# Windows parity: web-run.cmd likewise relaunches bun on ANY exit.
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
